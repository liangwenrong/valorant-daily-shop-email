#!/bin/sh

PID=/tmp/valorant-daily-shop-email.bind.pid
LOG=/tmp/valorant-daily-shop-email.log

if [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
	exit 0
fi

rm -f "$PID" "$LOG" /tmp/valorant-daily-shop-email/*_login_*.png
mkdir -p /tmp/valorant-daily-shop-email

start-stop-daemon -S -b -m -p "$PID" -x /bin/sh -- \
	-c "exec /usr/libexec/valorant-daily-shop-email/run bind >$LOG 2>&1"
