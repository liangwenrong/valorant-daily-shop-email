# Sender account and SMTP authorization code (not the mailbox password)
MAIL_USER=your_email@163.com
MAIL_PASS=your_smtp_authorization_code

# Recipient; defaults to MAIL_USER when omitted
MAIL_TO=recipient@example.com

# Optional SMTP settings
SMTP_HOST=smtp.163.com
SMTP_PORT=465

# Optional email subject prefix
VAL_SHOP_SUBJECT_PREFIX=无畏契约每日商店
